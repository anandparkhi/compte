# ---------------------------------------------------------------------------
# Compte — environment configuration. Copy to .env and fill in what you have.
# Everything works locally with NO paid keys (clearly labelled fallbacks).
# ---------------------------------------------------------------------------

# SQLite file for local development (PostgreSQL: see docs/DEPLOYMENT.md)
DATABASE_URL="file:./prisma/dev.db"

# Public URL of the app (used in links/emails)
APP_BASE_URL=http://localhost:3000

# Demo mode: shows the DEMO banner, prefilled demo login and the nil-filing simulator.
# Must be "false" in production. A production server refuses demo logins unless
# ALLOW_DEMO_IN_PRODUCTION=true is set explicitly (for a public demo deployment only).
DEMO_MODE=true
ALLOW_DEMO_IN_PRODUCTION=false

# Optional rename without code changes (all branding lives in src/lib/config/brand.ts)
# NEXT_PUBLIC_BRAND_NAME=Compte

# --- Claude (structured extraction). Without it, Compte's offline rule parser is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sarvam AI speech-to-text. Without it: "Transcription not configured", type instead. ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# --- Resend email. Without it, attempts are recorded as NOT_SENT and a preview is shown. ---
RESEND_API_KEY=
EMAIL_FROM="Your Business <invoices@yourdomain.example>"

# --- Inbound merchant SMS webhook (HMAC-SHA256 of raw body in X-Compte-Signature). ---
# The in-app SMS simulator works without this. Never point GSTN 14409 traffic here.
SMS_WEBHOOK_SECRET=
